rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.role == 'superadmin' ||
         request.auth.token.superadmin == true);
    }
    function isCourseOwner(courseId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/courses/$(courseId)) &&
        firestore.get(/databases/(default)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }
    function isDraftLessonOwner(courseId, videoId) {
      return isCourseOwner(courseId) &&
        firestore.exists(/databases/(default)/documents/courses/$(courseId)/videos/$(videoId)) &&
        firestore.get(/databases/(default)/documents/courses/$(courseId)/videos/$(videoId)).data.teacherId == request.auth.uid &&
        firestore.get(/databases/(default)/documents/courses/$(courseId)/videos/$(videoId)).data.status == 'draft' &&
        firestore.get(/databases/(default)/documents/courses/$(courseId)/videos/$(videoId)).data.approvalStatus == 'pending';
    }

    // Private course media: only the owner can upload while the lesson is a draft.
    // Client-side reads are denied; playback is issued by a short-lived server URL.
    match /course-videos/{courseId}/{videoId}/{fileName} {
      allow read: if false;
      allow create, update: if isDraftLessonOwner(courseId, videoId) &&
        request.resource.size > 0 &&
        request.resource.size <= 524288000 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if isAdmin() || isDraftLessonOwner(courseId, videoId);
    }
  }
}
